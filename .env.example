PORT=3000
APP_NAME="RepoTrackr AI"
ENV=dev
SECRET_KEY=repotrackr-secret-key-super-secure-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFY_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=memory
EMAIL_FROM=noreply@repotrackr.local
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=10/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
RATE_LIMIT_RESEND_VERIFICATION=5/minute
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=